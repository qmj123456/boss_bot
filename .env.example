# 复制本文件为 .env，然后填写你自己的本地密钥。
# .env 已被 .gitignore 忽略，不要把真实密钥提交到仓库。

# AI 接口配置。使用 OpenAI 官方接口时 base_url 保持下面这个值；
# 如果使用兼容 OpenAI 的中转服务，改成中转服务提供的 base_url。
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
# 在线简历截图分析使用的视觉模型名；留空时使用 config/ai.yaml 中的
# DeepSeek 官方视觉模型。仅当中转网关使用其他模型名时填写。
DEEPSEEK_VISION_MODEL=

# 飞书自建应用配置。
# app_id / app_secret 来自飞书开放平台的应用凭证。
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# 飞书多维表格配置。
# app_token 是多维表格应用 token；table_id 可先留空，
# 当 config/feishu.yaml 中 auto_create_table=true 时，程序会尝试自动创建数据表。
FEISHU_BITABLE_APP_TOKEN=bascn_xxx
FEISHU_BITABLE_TABLE_ID=

# Feishu group bot notifications (optional).
# Set FEISHU_BOT_SECRET only when the bot has signature verification enabled.
FEISHU_BOT_WEBHOOK=
FEISHU_BOT_SECRET=

# 可选：多岗位配置。
# FEISHU_TABLE_* 填写对应飞书多维表格数据表的 table_id，通常以 tbl 开头。
# BOSS_JOB_ID_* 填写 BOSS 直聘对应岗位的 encrypt_job_id。
# 如果 FEISHU_TABLE_* 留空且 config/feishu.yaml 中 auto_create_table=true，
# 程序会按 table_name 自动查找或创建飞书数据表。

# 岗位：全职主播
FEISHU_TABLE_FULLTIME_ANCHOR=
BOSS_JOB_NAME_FULLTIME_ANCHOR=
BOSS_JOB_ID_FULLTIME_ANCHOR=

# 岗位：兼职主播
FEISHU_TABLE_PARTTIME_ANCHOR=
BOSS_JOB_NAME_PARTTIME_ANCHOR=
BOSS_JOB_ID_PARTTIME_ANCHOR=

# 岗位：运营
FEISHU_TABLE_OPERATION=
BOSS_JOB_NAME_OPERATION=
BOSS_JOB_ID_OPERATION=

# 岗位：亚马逊运营
FEISHU_TABLE_AMAZON_OPERATION=
BOSS_JOB_NAME_AMAZON_OPERATION=
BOSS_JOB_ID_AMAZON_OPERATION=

# 岗位：TikTok运营
FEISHU_TABLE_TIKTOK_OPERATION=
BOSS_JOB_NAME_TIKTOK_OPERATION=
BOSS_JOB_ID_TIKTOK_OPERATION=

# 岗位：初级剪拍
FEISHU_TABLE_JUNIOR_SHOOT_EDIT=
BOSS_JOB_NAME_JUNIOR_SHOOT_EDIT=
BOSS_JOB_ID_JUNIOR_SHOOT_EDIT=

# 岗位：运营助理
FEISHU_TABLE_OPERATION_ASSISTANT=
BOSS_JOB_NAME_OPERATION_ASSISTANT=
BOSS_JOB_ID_OPERATION_ASSISTANT=

# 岗位：运营助理（前期需要在中控岗位轮岗）
FEISHU_TABLE_OPERATION_ASSISTANT_ROTATION=
BOSS_JOB_NAME_OPERATION_ASSISTANT_ROTATION=
BOSS_JOB_ID_OPERATION_ASSISTANT_ROTATION=

# 岗位：高级剪拍
FEISHU_TABLE_SENIOR_SHOOT_EDIT=
BOSS_JOB_NAME_SENIOR_SHOOT_EDIT=
BOSS_JOB_ID_SENIOR_SHOOT_EDIT=

# 岗位：客服
FEISHU_TABLE_CUSTOMER_SERVICE=
BOSS_JOB_NAME_CUSTOMER_SERVICE=
BOSS_JOB_ID_CUSTOMER_SERVICE=

# 岗位：编导
FEISHU_TABLE_BIANDAO=
BOSS_JOB_NAME_BIANDAO=
BOSS_JOB_ID_BIANDAO=

# 岗位：渲染
FEISHU_TABLE_RENDER=
BOSS_JOB_NAME_RENDER=
BOSS_JOB_ID_RENDER=

# 可选：默认岗位 ID。设置后部分命令可以不重复传 --encrypt-job-id。
BOSS_HR_ENCRYPT_JOB_ID=

# 运行输出目录。相对路径始终以项目根目录为基准，不受盘符和启动目录影响。
BOSS_HR_OUTPUT_DIR=data\runs

# ── 浏览器层防风控（默认全开；排障时可单独关闭，详见 README）──
# BOSS_HR_ANTI_DETECT=1
# BOSS_HR_RISK_GUARD=1
# BOSS_HR_BLOCK_SECURITY_SCRIPTS=1
# BOSS_HR_BLOCK_REPORTS=1
# BOSS_HR_CONSOLE_SANITIZE=1
# BOSS_HR_ALLOW_CONSOLE_CLEAR=0
# 逐字输入间隔 / 鼠标按下时长（毫秒）
# BOSS_HR_TYPING_MIN_MS=38
# BOSS_HR_TYPING_MAX_MS=125
# BOSS_HR_CLICK_MIN_MS=55
# BOSS_HR_CLICK_MAX_MS=180
# 熔断事件日志路径（默认 logs/risk_guard_events.jsonl）
# BOSS_HR_RISK_LOG=logs/risk_guard_events.jsonl
# BOSS_HR_ANTI_DETECT_DEBUG=0
